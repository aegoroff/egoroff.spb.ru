{
  "name": "ui.egoroff.spb.ru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && node scripts/vue-tsc-ts6.cjs --noEmit",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:vue": "node scripts/vue-tsc-ts6.cjs --noEmit",
    "build": "bun run typecheck && vite build && bun scripts/inject-askama-assets.ts",
    "devbuild": "vite build --mode development && bun scripts/inject-askama-assets.ts",
    "test": "bun test",
    "lint": "node --require ./scripts/eslint-ts6-alias.cjs ./node_modules/eslint/bin/eslint.js src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@marcoschulte/vue3-progress": "^0.0.9",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "highlight.js": "^11.12.0",
    "mitt": "^3.0.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue3-social-sharing": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "sass": "^1.104.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
